  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Soko Vibe ni nini?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Soko Vibe ni soko la mtandaoni la Tanzania linalounganisha wanunuzi na wauzaji. Huduma inaendeshwa kutoka Dar es Salaam, na bidhaa zinapatikana kote nchini."
        }
      },
      {
        "@type": "Question",
        "name": "Ninawezaje kununua bidhaa kwenye Soko Vibe?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Fungua akaunti, tafuta bidhaa kwa maandishi au kwa sauti, zungumza na muuzaji ndani ya app, lipa kwa escrow, kisha thibitisha kupokea kwa OTP."
        }
      },
      {
        "@type": "Question",
        "name": "Malipo yangu yanalindwaje?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Malipo yanaingia escrow kupitia ClickPesa na hutolewa kwa muuzaji tu baada ya mnunuzi kuthibitisha kupokea bidhaa. Mgogoro unaweza kufunguliwa na kushughulikiwa hadi siku 14."
        }
      },
      {
        "@type": "Question",
        "name": "Je, kuweka bidhaa kwenye Soko Vibe ni bure?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ndiyo. Kufungua orodha ni bure na muuzaji hupokea bei kamili ya bidhaa. Soko Vibe hutoza ada ya jukwaa ya 3.5% kwa mnunuzi wakati wa ununuzi. Udhamini (boost) ni wa hiari."
        }
      },
      {
        "@type": "Question",
        "name": "Naipataje app ya Soko Vibe?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "App ya Android inapatikana kwa link rasmi kupitia WhatsApp ya Soko Vibe. Viungo vya Google Play na App Store vitaongezwa mara app itakapochapishwa kwenye maduka."
        }
      },
      {
        "@type": "Question",
        "name": "Ninawezaje kupata msaada?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Wasiliana nasi kwa barua pepe support@sokovibe.co.tz, kwa WhatsApp +255 693 273 241, au tembelea kituo cha msaada kwenye https://www.sokovibe.co.tz/support."
        }
      }
    ]
  }
  </script>
