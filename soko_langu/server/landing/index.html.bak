  <main id="main">

    <!-- HERO -->
    <section class="hero" id="top">
      <div class="hero-blob blob-a" aria-hidden="true"></div>
      <div class="hero-blob blob-b" aria-hidden="true"></div>
      <div class="hero-blob blob-c" aria-hidden="true"></div>
      <div class="hero-inner">
        <div class="pill"><span class="pulse" aria-hidden="true"></span><span data-i18n="hero_badge">Soko la Tanzania · hatua ya awali</span></div>
        <h1 class="display">
          <span data-i18n="hero_h1_1">Nunua na uza Tanzania,</span>
          <span class="grad-text" data-i18n="hero_h1_2">kwa malipo yaliyolindwa.</span>
        </h1>
        <p class="lead" data-i18n="hero_sub">Soko Vibe ni soko la mtandaoni la Tanzania linalounganisha wanunuzi na wauzaji. Weka bidhaa bure, wasiliana moja kwa moja na muuzaji, na lipa kwa escrow — kote nchini.</p>

        <div class="hero-actions">
          <a class="btn btn-filled btn-lg" href="#waitlist" data-i18n="hero_cta_1">Jiunge na orodha ya taarifa</a>
          <a class="btn btn-ghost btn-lg" href="/categories" data-i18n="hero_cta_2">Vinjari kategoria</a>
        </div>

        <ul class="hero-facts">
          <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="11" width="18" height="11" rx="3"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg><span data-i18n="fact_escrow">Escrow kupitia ClickPesa</span></li>
          <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 6 9 17l-5-5"/></svg><span data-i18n="fact_kyc">Wauzaji waliothibitishwa (KYC)</span></li>
          <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M1 3h15v13H1z"/><path d="M16 8h4l3 3v5h-7z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg><span data-i18n="fact_delivery">Usafirishaji nchi nzima</span></li>
        </ul>

        <!-- WAITLIST -->
        <form class="waitlist-card" id="waitlistForm" novalidate>
          <div class="waitlist-head">
            <span class="waitlist-ico">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="2" y="4" width="20" height="16" rx="4"/><path d="m22 7-10 6L2 7"/></svg>
            </span>
            <div>
              <h2 id="waitlist" data-i18n="wl_title">Pata taarifa za uzinduzi</h2>
              <p data-i18n="wl_sub">Tutakuarifu kuhusu uzinduzi, masasisho na viungo vya maduka ya app.</p>
            </div>
          </div>
          <div class="waitlist-form">
            <label class="field">
              <span class="field-label" data-i18n="wl_name">Jina lako</span>
              <input type="text" id="wlName" name="name" autocomplete="name" maxlength="60" placeholder="Jina (si lazima)" data-ph-i18n="wl_name_ph">
            </label>
            <label class="field">
              <span class="field-label" data-i18n="wl_email">Barua pepe <em>*</em></span>
              <input type="email" id="wlEmail" name="email" autocomplete="email" maxlength="120" placeholder="mwandishi@mfano.co.tz" required data-ph-i18n="wl_email_ph">
            </label>
            <button class="btn btn-filled btn-lg" type="submit" data-i18n="wl_cta">Nipe taarifa</button>
          </div>
          <p class="form-msg" id="waitlistMsg" role="status"></p>
          <p class="privacy-note" data-i18n="wl_note">Barua pepe yako inatumika tu kukutumia taarifa za Soko Vibe. Hakuna spam.</p>
          <noscript><p class="privacy-note">JavaScript imezimwa. Tuma barua pepe kwa <a href="mailto:support@sokovibe.co.tz">support@sokovibe.co.tz</a> ili tuweze kukuarifu.</p></noscript>
        </form>
        <div class="waitlist-card done hidden" id="waitlistDone">
          <div class="done-burst">
            <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 6 9 17l-5-5"/></svg>
          </div>
          <h2 data-i18n="wl_done_title">Umefanikiwa!</h2>
          <p data-i18n="wl_done_body">Umeingizwa kwenye orodha. Tutakuarifu mara app na viungo vya maduka vitakapozinduliwa.</p>
        </div>
      </div>
    </section>

    <!-- TICKER -->
    <div class="ticker" aria-hidden="true">
      <div class="ticker-inner">
        <span>M-Pesa</span><i></i><span>Tigo Pesa</span><i></i><span>Airtel Money</span><i></i><span>HaloPesa</span><i></i><span>Escrow Salama</span><i></i><span>Usafirishaji Tanzania Nzima</span><i></i><span>Chat ya Moja kwa Moja</span><i></i>
        <span>M-Pesa</span><i></i><span>Tigo Pesa</span><i></i><span>Airtel Money</span><i></i><span>HaloPesa</span><i></i><span>Escrow Salama</span><i></i><span>Usafirishaji Tanzania Nzima</span><i></i><span>Chat ya Moja kwa Moja</span><i></i>
      </div>
    </div>

    <!-- WHAT IT IS -->
    <section class="section" id="sifa">
      <div class="section-head">
        <div class="eyebrow" data-i18n="sifa_eyebrow">Soko Vibe ni nini</div>
        <h2 data-i18n="sifa_h2">Soko moja la Tanzania, kwa wanunuzi na wauzaji.</h2>
        <p class="lead" data-i18n="sifa_lead">Soko Vibe ni jukwaa la kidijitali linaloendeshwa kutoka Dar es Salaam. Linawaunganisha wanunuzi na wauzaji wa bidhaa na huduma kote Tanzania, kwa mazungumzo ya moja kwa moja na malipo yanayolindwa.</p>
      </div>
      <div class="audience-grid">
        <article class="audience-card">
          <div class="audience-ico" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" focusable="false"><circle cx="9" cy="20" r="1.6"/><circle cx="18" cy="20" r="1.6"/><path d="M2 3h3l2.6 12.4a2 2 0 0 0 2 1.6h8.2a2 2 0 0 0 2-1.6L21.5 7H6"/></svg></div>
          <h3 data-i18n="aud_b_t">Kwa wanunuzi</h3>
          <p data-i18n="aud_b_p">Tafuta bidhaa mpya na za mitumba, linganisha bei, na uliza muuzaji moja kwa moja kabla ya kununua. Malipo yako yanalindwa hadi uthibitishe kupokea.</p>
        </article>
        <article class="audience-card">
          <div class="audience-ico" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M3 9h18l-1.6 9.2a2 2 0 0 1-2 1.8H6.6a2 2 0 0 1-2-1.8z"/><path d="M8 9V6a4 4 0 0 1 8 0v3"/></svg></div>
          <h3 data-i18n="aud_s_t">Kwa wauzaji na biashara</h3>
          <p data-i18n="aud_s_p">Weka bidhaa bure, thibitisha utambulisho (KYC), na simamia duka lako kwenye dashboard moja — pamoja na boost za hiari na takwimu za mauzo.</p>
        </article>
        <article class="audience-card">
          <div class="audience-ico" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M3 21h18"/><path d="M5 21V7l7-4 7 4v14"/><path d="M9 21v-5h6v5"/></svg></div>
          <h3 data-i18n="aud_c_t">Kategoria halisi</h3>
          <p data-i18n="aud_c_p">Elektroniki, mavazi, nyumba na bustani, magari, afya na urembo, chakula, na huduma — bidhaa zimepangwa ili kuvinjari kwa urahisi.</p>
        </article>
      </div>
      <ul class="link-list">
        <li><a href="/tanzania-marketplace" data-i18n="lnk_market">Soko la Tanzania</a></li>
        <li><a href="/categories" data-i18n="lnk_cats">Kategoria zote</a></li>
        <li><a href="/how-soko-vibe-works" data-i18n="lnk_how">Jinsi inavyofanya kazi</a></li>
        <li><a href="/about" data-i18n="lnk_about">Kuhusu Soko Vibe</a></li>
      </ul>
      <div class="en-summary" lang="en">
        <p>Soko Vibe is a Tanzania-based online marketplace, operated from Dar es Salaam, that connects buyers and sellers across the country. Sellers list products for free, buyers pay through escrow via ClickPesa, and both sides communicate inside the app. Read more on the <a href="/tanzania-marketplace">Tanzania marketplace</a> page.</p>
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section class="section section-alt" id="jinsi">
      <div class="section-head">
        <div class="eyebrow" data-i18n="how_eyebrow">Jinsi inavyofanya kazi</div>
        <h2 data-i18n="how_h2">Hatua nne kutoka kutafuta hadi kupokea.</h2>
        <p class="lead" data-i18n="how_lead">Kila agizo linafuata mchakato mmoja unaolinda pande zote mbili.</p>
      </div>
      <div class="step-grid">
        <article class="step-card">
          <div class="step-n" data-i18n="st1_n">Hatua 01</div>
          <h3 data-i18n="st1_t">Fungua akaunti</h3>
          <p data-i18n="st1_p">Jisajili kama mnunuzi au muuzaji. Wauzaji huthibitisha utambulisho (KYC) kabla ya kuanza kuuza.</p>
        </article>
        <article class="step-card">
          <div class="step-n" data-i18n="st2_n">Hatua 02</div>
          <h3 data-i18n="st2_t">Tafuta na zungumza</h3>
          <p data-i18n="st2_p">Vinjari kategoria au tafuta kwa maandishi na kwa sauti, kisha uliza muuzaji ndani ya app.</p>
        </article>
        <article class="step-card">
          <div class="step-n" data-i18n="st3_n">Hatua 03</div>
          <h3 data-i18n="st3_t">Lipa kwa escrow</h3>
          <p data-i18n="st3_p">Lipa kwa mobile money. Fedha zinashikiliwa kwa escrow kupitia ClickPesa, si kwa muuzaji bado.</p>
        </article>
        <article class="step-card">
          <div class="step-n" data-i18n="st4_n">Hatua 04</div>
          <h3 data-i18n="st4_t">Thibitisha na kadiria</h3>
          <p data-i18n="st4_p">Pokea bidhaa, thibitisha kwa OTP, na fedha hutolewa kwa muuzaji. Kama kuna tatizo, fungua mgogoro.</p>
        </article>
      </div>
      <p class="section-foot"><a href="/how-soko-vibe-works" data-i18n="lnk_how_full">Soma maelezo kamili ya jinsi inavyofanya kazi →</a></p>
    </section>

    <!-- FEES / TRUST -->
    <section class="section" id="bei">
      <div class="section-head">
        <div class="eyebrow" data-i18n="fee_eyebrow">Ada zilizo wazi</div>
        <h2 data-i18n="fee_h2">Hakuna ada zilizofichwa.</h2>
        <p class="lead" data-i18n="fee_lead">Unajua unalipa nini kabla ya kukamilisha ununuzi.</p>
      </div>
      <div class="fee-grid">
        <article class="fee-card">
          <h3 data-i18n="fee1_t">Kufungua orodha</h3>
          <p class="fee-amount" data-i18n="fee1_amt">Bure</p>
          <p class="fee-basis" data-i18n="fee1_basis">Kwa kila muuzaji</p>
          <p data-i18n="fee1_p">Weka bidhaa bila gharama. Hakuna ada ya kuuza na hakuna usajili wa kudumu.</p>
        </article>
        <article class="fee-card">
          <h3 data-i18n="fee2_t">Ada ya jukwaa</h3>
          <p class="fee-amount" data-i18n="fee2_amt">3.5%</p>
          <p class="fee-basis" data-i18n="fee2_basis">Kwa mnunuzi, wakati wa ununuzi</p>
          <p data-i18n="fee2_p">Muuzaji hupokea bei kamili ya bidhaa. Ada inaonekana wazi kabla ya malipo kukamilika.</p>
        </article>
      </div>
      <p class="section-foot"><a href="/soko-vibe-fees" data-i18n="lnk_fees">Ada zote na udhamini →</a> · <a href="/soko-vibe-escrow" data-i18n="lnk_escrow">Escrow na usalama wa malipo →</a></p>
    </section>

    <!-- FAQ -->
    <section class="section section-alt" id="maswali">
      <div class="section-head">
        <div class="eyebrow" data-i18n="faq_eyebrow">Maswali</div>
        <h2 data-i18n="faq_h2">Maswali yanayoulizwa mara kwa mara.</h2>
      </div>
      <div class="faq">
        <details>
          <summary data-i18n="q1">Soko Vibe ni nini?</summary>
          <div class="faq-body"><p data-i18n="a1">Soko Vibe ni soko la mtandaoni la Tanzania linalounganisha wanunuzi na wauzaji. Huduma inaendeshwa kutoka Dar es Salaam, na bidhaa zinapatikana kote nchini.</p></div>
        </details>
        <details>
          <summary data-i18n="q2">Ninawezaje kununua bidhaa kwenye Soko Vibe?</summary>
          <div class="faq-body"><p data-i18n="a2">Fungua akaunti, tafuta bidhaa kwa maandishi au kwa sauti, zungumza na muuzaji ndani ya app, lipa kwa escrow, kisha thibitisha kupokea kwa OTP.</p></div>
        </details>
        <details>
          <summary data-i18n="q3">Malipo yangu yanalindwaje?</summary>
          <div class="faq-body"><p data-i18n="a3">Malipo yanaingia escrow kupitia ClickPesa na hutolewa kwa muuzaji tu baada ya mnunuzi kuthibitisha kupokea bidhaa. Mgogoro unaweza kufunguliwa na kushughulikiwa hadi siku 14. Soma zaidi kwenye ukurasa wa escrow.</p></div>
        </details>
        <details>
          <summary data-i18n="q4">Je, kuweka bidhaa kwenye Soko Vibe ni bure?</summary>
          <div class="faq-body"><p data-i18n="a4">Ndiyo. Kufungua orodha ni bure na muuzaji hupokea bei kamili ya bidhaa. Soko Vibe hutoza ada ya jukwaa ya 3.5% kwa mnunuzi wakati wa ununuzi. Udhamini (boost) ni wa hiari.</p></div>
        </details>
        <details>
          <summary data-i18n="q5">Naipataje app ya Soko Vibe?</summary>
          <div class="faq-body"><p data-i18n="a5">App ya Android inapatikana kwa link rasmi kupitia WhatsApp ya Soko Vibe. Viungo vya Google Play na App Store vitaongezwa mara app itakapochapishwa kwenye maduka.</p></div>
        </details>
        <details>
          <summary data-i18n="q6">Ninawezaje kupata msaada?</summary>
          <div class="faq-body"><p data-i18n="a6">Wasiliana nasi kwa barua pepe support@sokovibe.co.tz, kwa WhatsApp +255 693 273 241, au tembelea kituo cha msaada.</p></div>
        </details>
      </div>
      <p class="section-foot"><a href="/support" data-i18n="lnk_support">Kituo cha msaada →</a></p>
    </section>

    <!-- APP -->
    <section class="section" id="app">
      <div class="app-panel">
        <div class="eyebrow" data-i18n="app_eyebrow">App</div>
        <h2 data-i18n="app_h2">Soko Vibe mfukoni mwako.</h2>
        <p data-i18n="app_p">App ya Android inapatikana kwa link rasmi kupitia WhatsApp. Viungo vya Google Play na App Store vitaongezwa mara app itakapochapishwa kwenye maduka — hakuna kiungo cha kubuni kinachoonekana hapa.</p>
        <div class="hero-actions">
          <a class="btn btn-filled btn-lg" href="https://wa.me/255693273241?text=Hi%2C%20nataka%20kupata%20app%20ya%20Soko%20Vibe." rel="noopener" data-i18n="app_cta">Omba app kwa WhatsApp</a>
          <a class="btn btn-ghost btn-lg" href="#waitlist" data-i18n="app_cta2">Nipe taarifa za uzinduzi</a>
        </div>
        <p class="app-note" data-i18n="app_note">Msaada: support@sokovibe.co.tz · WhatsApp +255 693 273 241</p>
      </div>
    </section>

    <!-- FEEDBACK + COMMENTS -->
    <section class="section band" id="maoni">
      <div class="two-col">
        <div class="panel" id="feedback">
          <div class="section-head left">
            <div class="eyebrow" data-i18n="fb_eyebrow">Maoni yako yanahesabika</div>
            <h2 data-i18n="fb_h2">Unataka app iwe na nini?</h2>
            <p class="lead" data-i18n="fb_sub">Chagua vipengele na utueleze maoni yako. Tunasikiliza kila mmoja.</p>
          </div>
          <form class="stack" id="feedbackForm" novalidate>
            <fieldset class="chips-field">
              <legend data-i18n="fb_features">Vipengele unavyovipenda</legend>
              <div class="chips" id="featureChips">
                <label class="chip on"><input type="checkbox" value="Escrow" checked><span data-i18n="fb_f1">Escrow Salama</span></label>
                <label class="chip"><input type="checkbox" value="Chat"><span data-i18n="fb_f2">Chat ya Moja kwa Moja</span></label>
                <label class="chip"><input type="checkbox" value="Delivery"><span data-i18n="fb_f3">Usafirishaji nchi nzima</span></label>
                <label class="chip"><input type="checkbox" value="Voice Search"><span data-i18n="fb_f4">Utafutaji wa Sauti / AI</span></label>
                <label class="chip"><input type="checkbox" value="Seller Store"><span data-i18n="fb_f5">Duka la Mfanyabiashara</span></label>
                <label class="chip"><input type="checkbox" value="Wallet"><span data-i18n="fb_f6">Pochi ya Simu</span></label>
                <label class="chip"><input type="checkbox" value="Ratings"><span data-i18n="fb_f7">Ukadiriaji wa Wauzaji</span></label>
                <label class="chip"><input type="checkbox" value="Languages"><span data-i18n="fb_f8">Lugha nyingi</span></label>
              </div>
            </fieldset>
            <label class="field">
              <span class="field-label" data-i18n="fb_details">Maoni / maelezo zaidi</span>
              <textarea id="fbDetails" rows="4" maxlength="1500" placeholder="Mfano: ningependa..." data-ph-i18n="fb_details_ph"></textarea>
            </label>
            <div class="row">
              <label class="field grow">
                <span class="field-label" data-i18n="fb_name">Jina</span>
                <input type="text" id="fbName" maxlength="60" autocomplete="name">
              </label>
              <label class="field grow">
                <span class="field-label" data-i18n="fb_email">Barua pepe</span>
                <input type="email" id="fbEmail" maxlength="120" autocomplete="email">
              </label>
            </div>
            <button class="btn btn-filled btn-lg" type="submit" data-i18n="fb_cta">Tuma maoni</button>
            <p class="form-msg" id="feedbackMsg" role="status"></p>
          </form>
        </div>

        <div class="panel" id="comments">
          <div class="section-head left">
            <div class="eyebrow" data-i18n="cm_eyebrow">Jamii imesema</div>
            <h2 data-i18n="cm_h2">Maoni ya wananchi</h2>
          </div>
          <div class="comment-list" id="commentList">
            <div class="comment-skel"></div>
            <div class="comment-skel"></div>
            <div class="comment-skel"></div>
          </div>
          <form class="stack" id="commentForm" novalidate>
            <div class="row">
              <label class="field grow">
                <span class="field-label" data-i18n="cm_name">Jina lako <em>*</em></span>
                <input type="text" id="cmName" maxlength="60" autocomplete="name" required>
              </label>
              <label class="field grow">
                <span class="field-label" data-i18n="cm_email">Barua pepe</span>
                <input type="email" id="cmEmail" maxlength="120" autocomplete="email">
              </label>
            </div>
            <label class="field">
              <span class="field-label" data-i18n="cm_text">Maoni yako <em>*</em></span>
              <textarea id="cmText" rows="3" maxlength="1000" placeholder="..." data-ph-i18n="cm_text_ph" required></textarea>
            </label>
            <button class="btn btn-filled btn-lg" type="submit" data-i18n="cm_cta">Chapisha maoni</button>
            <p class="form-msg" id="commentMsg" role="status"></p>
          </form>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section">
      <div class="cta-band">
        <h2 data-i18n="cta_h2">Tayari kuanza?</h2>
        <p data-i18n="cta_p">Jiunge na orodha ya taarifa, au wasiliana nasi moja kwa moja — tunajibu kwa Kiswahili na Kiingereza.</p>
        <button class="btn btn-outline-light" id="ctaBtn" data-i18n="cta_btn">Jiandikishe sasa</button>
      </div>
    </section>
  </main>

