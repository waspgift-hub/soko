/* Soko Vibe landing — premium black/white, system fonts, no gradients, no emojis. */

:root {
  --black: #000000;
  --white: #ffffff;
  --ink: #0a0a0a;
  --muted: #525252;
  --faint: #8a8a8a;
  --line: #e5e5e5;
  --line-dark: #262626;
  --radius: 16px;
  --radius-sm: 10px;
  --max: 1120px;
  --gutter: 24px;
}

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, *::before, *::after { animation: none !important; transition: none !important; }
}

body {
  margin: 0;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  color: var(--ink);
  background: var(--white);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

img { display: block; max-width: 100%; }
a { color: inherit; }
h1, h2, h3, h4, p { margin: 0; }

.container {
  max-width: var(--max);
  margin: 0 auto;
  padding: 0 var(--gutter);
}

/* ---------- Header ---------- */

.site-header {
  position: sticky;
  top: 0;
  z-index: 50;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(8px);
  border-bottom: 1px solid var(--line);
}

.nav-bar {
  display: flex;
  align-items: center;
  gap: 24px;
  height: 68px;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  text-decoration: none;
  font-weight: 700;
  letter-spacing: -0.01em;
}

.brand-mark { border-radius: 8px; }

.brand-name { font-size: 1.1rem; }

.nav-links {
  display: flex;
  align-items: center;
  gap: 4px;
  margin-left: auto;
}

.nav-links a {
  text-decoration: none;
  color: var(--muted);
  font-size: 0.95rem;
  font-weight: 500;
  padding: 8px 12px;
  border-radius: var(--radius-sm);
  transition: color 0.15s ease, background 0.15s ease;
}

.nav-links a:hover,
.nav-links a:focus-visible {
  color: var(--ink);
  background: var(--line);
}

.nav-cta, .btn {
  text-decoration: none;
  font-weight: 600;
  border-radius: var(--radius-sm);
  white-space: nowrap;
}

.nav-cta {
  font-size: 0.92rem;
  padding: 10px 18px;
  color: var(--white);
  background: var(--black);
  border: 1px solid var(--black);
  transition: opacity 0.15s ease;
}

.nav-cta:hover { opacity: 0.85; }

.lang-select {
  font: inherit;
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--ink);
  background: var(--white);
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  padding: 9px 12px;
  cursor: pointer;
  white-space: nowrap;
}

.lang-select:hover { border-color: var(--black); }
.lang-select:focus-visible { outline: 2px solid var(--black); outline-offset: 2px; }

.menu-btn {
  display: none;
  flex-direction: column;
  justify-content: center;
  gap: 5px;
  width: 44px;
  height: 44px;
  padding: 10px;
  background: none;
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  cursor: pointer;
}

.menu-line {
  display: block;
  height: 2px;
  background: var(--black);
  border-radius: 2px;
}

@media (max-width: 820px) {
  .nav-links {
    display: none;
    position: absolute;
    top: 68px;
    left: 0;
    right: 0;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    margin: 0;
    padding: 12px;
    background: var(--white);
    border-bottom: 1px solid var(--line);
  }

  .nav-bar.open .nav-links { display: flex; }
  .nav-links a { padding: 14px 12px; border-radius: var(--radius-sm); }
  .menu-btn { display: flex; }
}

/* ---------- Hero ---------- */

.hero {
  background: var(--black);
  color: var(--white);
  text-align: center;
  padding: 96px 0 72px;
  overflow: hidden;
}

/* Two-column hero on desktop; stacked copy-first on mobile so the CTA
   stays in the first viewport. Note + pay strip always span full width. */
.hero-grid {
  display: grid;
  gap: 56px;
  align-items: center;
  text-align: center;
}

.hero-grid > .note,
.hero-grid > .pay-strip {
  grid-column: 1 / -1;
}

@media (min-width: 960px) {
  .hero-grid {
    grid-template-columns: 1.05fr 0.95fr;
    text-align: left;
  }
  .hero-copy .sub { margin-left: 0; margin-right: 0; }
  .hero-copy .actions { justify-content: flex-start; }
}

.hero-mark {
  width: 72px;
  height: 72px;
  margin: 0 auto 28px;
  border-radius: 18px;
  box-shadow: 0 0 0 1px #333333, 0 24px 60px rgba(255, 255, 255, 0.12);
}

@media (min-width: 960px) {
  .hero-mark { margin-left: 0; margin-right: 0; }
}

/* ---------- CSS phone mockup (original artwork, no downloads) ---------- */

.hero-visual {
  display: flex;
  justify-content: center;
}

.phone {
  width: min(280px, 72vw);
  border-radius: 44px;
  border: 1px solid #3a3a3a;
  background: #101010;
  padding: 12px;
  box-shadow: 0 0 0 8px #050505, 0 32px 80px rgba(255, 255, 255, 0.1);
  animation: phone-float 6s ease-in-out infinite;
}

@keyframes phone-float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10px); }
}

.phone-notch {
  width: 96px;
  height: 22px;
  margin: 2px auto 10px;
  border-radius: 999px;
  background: #050505;
  border: 1px solid #2a2a2a;
}

.phone-screen {
  border-radius: 32px;
  background: var(--white);
  color: var(--ink);
  padding: 14px 12px 16px;
  text-align: left;
}

.mock-search {
  font-size: 0.8rem;
  color: var(--faint);
  background: #f1f1f1;
  border-radius: 999px;
  padding: 8px 14px;
  margin-bottom: 12px;
}

.mock-cards {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  margin-bottom: 12px;
}

.mock-card {
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 8px;
}

.mock-img {
  height: 64px;
  border-radius: 8px;
  margin-bottom: 8px;
}

.mock-img-a { background: #0a0a0a; }
.mock-img-b { background: #3d3d3d; }

.mock-name {
  font-size: 0.75rem;
  font-weight: 600;
}

.mock-price {
  font-size: 0.75rem;
  font-weight: 700;
}

.mock-escrow {
  display: inline-block;
  margin-top: 4px;
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  color: #15803d;
  background: rgba(22, 163, 74, 0.12);
  border-radius: 999px;
  padding: 2px 8px;
}

.mock-chat {
  font-size: 0.78rem;
  background: #0a0a0a;
  color: var(--white);
  border-radius: 14px 14px 14px 4px;
  padding: 8px 12px;
  max-width: 85%;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-size: 0.85rem;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--faint);
  margin-bottom: 20px;
}

.eyebrow::before {
  content: "";
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--white);
}

.hero h1 {
  font-size: clamp(2.2rem, 6vw, 4rem);
  line-height: 1.08;
  letter-spacing: -0.03em;
  margin-bottom: 24px;
}

.hero .muted { color: #9a9a9a; }

.hero .sub {
  max-width: 640px;
  margin: 0 auto 36px;
  font-size: 1.15rem;
  color: #cccccc;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 14px;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 14px 26px;
  font-size: 1rem;
  transition: opacity 0.15s ease;
}

.btn:hover { opacity: 0.85; }

.btn-light { background: var(--white); color: var(--black); border: 1px solid var(--white); }
.btn-dark { background: var(--black); color: var(--white); border: 1px solid var(--black); }
.btn-outline { background: transparent; color: var(--white); border: 1px solid #444444; }

.hero .note {
  margin-top: 20px;
  font-size: 0.9rem;
  color: #9a9a9a;
}

.hero .proof {
  margin-top: 14px;
  font-size: 0.85rem;
  font-weight: 600;
  letter-spacing: 0.02em;
  color: #c9c9c9;
}

.pay-strip {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10px 14px;
  margin-top: 56px;
  padding-top: 28px;
  border-top: 1px solid #1f1f1f;
  font-size: 0.85rem;
  font-weight: 500;
  color: #8a8a8a;
}

.pay-strip span::after {
  content: "·";
  margin-left: 14px;
  color: #3a3a3a;
}

.pay-strip span:last-child::after { content: ""; margin: 0; }

/* ---------- Sections ---------- */

.section { padding: 96px 0; }

.section.dark {
  background: var(--black);
  color: var(--white);
}

.intro {
  padding: 64px 0;
  border-bottom: 1px solid var(--line);
}

.intro .container {
  max-width: 860px;
  font-size: 1.25rem;
  line-height: 1.7;
  color: var(--muted);
  text-align: center;
}

.section-head {
  max-width: 680px;
  margin: 0 auto 48px;
  text-align: center;
}

.section-eyebrow {
  font-size: 0.82rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--faint);
  margin-bottom: 12px;
}

.section-eyebrow.light { color: #8a8a8a; }

.section-head h2 {
  font-size: clamp(1.7rem, 4vw, 2.5rem);
  letter-spacing: -0.02em;
  line-height: 1.15;
  margin-bottom: 14px;
}

.section-head p {
  color: var(--muted);
  font-size: 1.05rem;
}

.section.dark .section-head p { color: #a6a6a6; }

/* ---------- Features ---------- */

.features {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.feature {
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 28px;
  transition: transform 0.2s ease, border-color 0.2s ease;
}

.feature:hover {
  transform: translateY(-3px);
  border-color: #c9c9c9;
}

.ico {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 46px;
  height: 46px;
  margin-bottom: 18px;
  border: 1px solid var(--line);
  border-radius: 12px;
  color: var(--black);
}

.ico svg { width: 22px; height: 22px; }

.feature h3 { font-size: 1.12rem; letter-spacing: -0.01em; margin-bottom: 8px; }
.feature p { color: var(--muted); font-size: 0.97rem; }

/* ---------- Steps ---------- */

.steps {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}

.step {
  padding: 0;
}

.step .n {
  font-size: 0.9rem;
  font-weight: 700;
  color: #8a8a8a;
  letter-spacing: 0.08em;
  margin-bottom: 14px;
}

.step h3 { font-size: 1.1rem; margin-bottom: 8px; }

.step p {
  color: #a6a6a6;
  font-size: 0.95rem;
}

/* ---------- Pricing ---------- */

.pricing {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
  max-width: 860px;
  margin: 0 auto 20px;
}

.price-card {
  position: relative;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 32px 28px;
  text-align: center;
}

.price-card.popular {
  border-color: var(--black);
  background: var(--black);
  color: var(--white);
}

.price-popular {
  position: absolute;
  top: 14px;
  right: 18px;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  padding: 4px 10px;
  border: 1px solid #3a3a3a;
  border-radius: 999px;
  color: #cccccc;
}

.price-card h3 { font-size: 1rem; font-weight: 600; margin-bottom: 8px; }

.price-amount { font-size: 1.9rem; font-weight: 700; letter-spacing: -0.02em; }

.price-duration {
  font-size: 0.85rem;
  color: var(--faint);
  margin-bottom: 18px;
}

.price-card.popular .price-duration { color: #8a8a8a; }

.price-feature { font-size: 0.95rem; color: var(--muted); }

.price-card.popular .price-feature { color: #cccccc; }

.price-note {
  text-align: center;
  font-size: 0.9rem;
  color: var(--faint);
  margin: 8px 0 40px;
}

.list {
  list-style: none;
  margin: 0 auto;
  padding: 0;
  max-width: 720px;
  display: grid;
  gap: 14px;
}

.list li {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 1rem;
  color: var(--muted);
}

.check {
  flex: none;
  width: 22px;
  height: 22px;
  border: 1px solid var(--black);
  border-radius: 50%;
  position: relative;
}

.check::after {
  content: "";
  position: absolute;
  left: 7px;
  top: 4px;
  width: 5px;
  height: 9px;
  border: solid var(--black);
  border-width: 0 2px 2px 0;
  transform: rotate(45deg);
}

/* ---------- Trust ---------- */

.trust-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24px;
}

.trust-item {
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 28px;
}

.trust-item h3 { font-size: 1.05rem; margin-bottom: 8px; }
.trust-item p { color: var(--muted); font-size: 0.97rem; }
.trust-item a { color: var(--ink); text-decoration: underline; text-underline-offset: 2px; }

/* ---------- CTA / App band ---------- */

.cta-band {
  text-align: center;
  padding: 56px 40px;
  border-radius: var(--radius);
  background: var(--black);
  color: var(--white);
}

.cta-band h2 { font-size: clamp(1.6rem, 4vw, 2.3rem); letter-spacing: -0.02em; margin-bottom: 14px; }

.cta-band p {
  max-width: 620px;
  margin: 0 auto 28px;
  color: #cccccc;
  font-size: 1.05rem;
}

.store-links {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 14px;
  margin-top: 36px;
}

.store-link {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  padding: 12px 18px;
  border: 1px solid #333333;
  border-radius: var(--radius-sm);
  opacity: 0.85;
}

.store-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border-radius: 8px;
  background: var(--white);
  color: var(--black);
  font-weight: 700;
}

.store-text { display: flex; flex-direction: column; text-align: left; }

.store-name { font-weight: 600; font-size: 0.95rem; }

.store-status { font-size: 0.78rem; color: #9a9a9a; }

/* ---------- FAQ ---------- */

.faq-list {
  max-width: 760px;
  margin: 0 auto;
  border-top: 1px solid var(--line);
}

.faq-item {
  border-bottom: 1px solid var(--line);
}

.faq-item summary {
  cursor: pointer;
  list-style: none;
  padding: 22px 4px;
  font-size: 1.05rem;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.faq-item summary::-webkit-details-marker { display: none; }

.faq-item summary::after {
  content: "+";
  font-size: 1.4rem;
  font-weight: 400;
  color: var(--faint);
  transition: transform 0.2s ease;
}

.faq-item[open] summary::after { transform: rotate(45deg); }

.faq-item p {
  padding: 0 4px 22px;
  color: var(--muted);
  font-size: 0.98rem;
}

/* ---------- Footer ---------- */

.site-footer {
  background: var(--black);
  color: var(--white);
  padding: 72px 0 0;
}

.footer-grid {
  display: grid;
  grid-template-columns: 1.4fr 1fr 1fr 1fr;
  gap: 40px;
  padding-bottom: 56px;
}

.footer-brand .brand { color: var(--white); margin-bottom: 16px; }

.footer-brand p {
  color: #9a9a9a;
  font-size: 0.95rem;
  max-width: 280px;
}

.col h4 {
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #8a8a8a;
  margin-bottom: 16px;
}

.col a {
  display: block;
  color: #d4d4d4;
  text-decoration: none;
  font-size: 0.95rem;
  padding: 5px 0;
}

.col a:hover { color: var(--white); text-decoration: underline; text-underline-offset: 3px; }

.footer-bottom {
  border-top: 1px solid #1f1f1f;
  padding: 22px 0;
  font-size: 0.85rem;
  color: #8a8a8a;
}

/* ---------- Reveal ---------- */

[data-reveal] {
  opacity: 0;
  transform: translateY(14px);
  transition: opacity 0.55s ease, transform 0.55s ease;
}

[data-reveal].in {
  opacity: 1;
  transform: none;
}

@media (prefers-reduced-motion: reduce) {
  [data-reveal] { opacity: 1; transform: none; }
}

/* ---------- Responsive ---------- */

@media (max-width: 980px) {
  .features, .steps { grid-template-columns: repeat(2, 1fr); }
  .footer-grid { grid-template-columns: 1fr 1fr; }
}

@media (max-width: 680px) {
  .section { padding: 64px 0; }
  .hero { padding: 72px 0 56px; }
  .features, .steps, .pricing, .trust-grid { grid-template-columns: 1fr; }
  .footer-grid { grid-template-columns: 1fr; gap: 28px; }
  .cta-band { padding: 44px 24px; }
}

/* ---------- Public pages (About / Marketplace / Founder / Categories) ---------- */

.page-hero {
  padding: 96px 0 56px;
  text-align: center;
}

.page-hero .eyebrow { margin-bottom: 18px; }

.page-hero h1 {
  font-size: clamp(2rem, 5vw, 3rem);
  letter-spacing: -0.03em;
  line-height: 1.08;
  margin: 0 0 18px;
}

.page-hero .sub {
  color: #9a9a9a;
  font-size: 1.1rem;
  max-width: 640px;
  margin: 0 auto;
}

.prose {
  max-width: 720px;
  margin: 0 auto;
  font-size: 1.02rem;
  line-height: 1.75;
  color: #d4d4d4;
}

.prose p { margin: 0 0 20px; }

.prose h2 {
  font-size: 1.35rem;
  letter-spacing: -0.01em;
  margin: 44px 0 14px;
  color: var(--white);
}

.prose h3 {
  font-size: 1.05rem;
  margin: 28px 0 8px;
  color: var(--white);
}

.prose ul, .prose ol {
  margin: 0 0 20px;
  padding-left: 22px;
}

.prose li { margin-bottom: 8px; }

.prose a {
  color: var(--white);
  text-decoration: underline;
  text-underline-offset: 3px;
}

.prose .en {
  display: block;
  margin: 26px auto 0;
  max-width: 640px;
  font-size: 1.02rem;
  line-height: 1.7;
  color: #d4d4d4;
  border-left: 2px solid var(--white);
  padding-left: 18px;
}

.intro-link {
  display: inline-flex;
  margin-top: 22px;
  gap: 8px;
  align-items: center;
  color: var(--white);
  text-decoration: none;
  font-weight: 600;
}

.intro-link:hover { text-decoration: underline; text-underline-offset: 3px; }

.intro-link::after { content: "→"; }

.cat-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}

.cat-item {
  background: #101010;
  border: 1px solid #1f1f1f;
  border-radius: 16px;
  padding: 24px;
}

.cat-item h3 { margin: 0 0 6px; font-size: 1.05rem; }

.cat-item p { margin: 0; color: #9a9a9a; font-size: 0.92rem; line-height: 1.6; }

@media (max-width: 980px) {
  .cat-grid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 680px) {
  .page-hero { padding: 64px 0 40px; }
  .cat-grid { grid-template-columns: 1fr; }
}

/* ---------- Hero mock: app home (categories + escrow + chat) ---------- */

.phone-notch {
  width: 112px;
  height: 22px;
  margin: 4px auto 12px;
  border-radius: 999px;
  background: #050505;
  border: 1px solid #2a2a2a;
}

.phone-screen {
  border-radius: 32px;
  background: var(--white);
  color: var(--ink);
  padding: 12px 10px 16px;
  text-align: left;
}

.mock-appbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 12px;
  padding: 0 4px;
}

.mock-appbar-brand {
  font-size: 0.86rem;
  font-weight: 800;
  letter-spacing: -0.01em;
}

.mock-appbar-cart {
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.02em;
  color: var(--white);
  background: #0a0a0a;
  border: 1px solid #0a0a0a;
  border-radius: 999px;
  padding: 4px 10px;
}

.mock-search {
  font-size: 0.8rem;
  color: var(--faint);
  background: #f1f1f1;
  border-radius: 999px;
  padding: 8px 14px;
  margin-bottom: 12px;
}

.mock-cats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  margin-bottom: 12px;
}

.mock-cat {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 0;
  font-size: 0.78rem;
  font-weight: 600;
  background: transparent;
}

.mock-cat span:last-child {
  font-size: 0.78rem;
  font-weight: 600;
}

.cat-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 40px;
  height: 40px;
  border-radius: 13px;
}

.cat-icon-a { background: #0a0a0a; color: #ffffff; }
.cat-icon-b { background: #3d3d3d; color: #ffffff; }
.cat-icon-c { background: #1f2937; color: #ffffff; }
.cat-icon-d { background: #0f172a; color: #ffffff; }

/* ---- CSS-drawn category glyphs (original, no downloads) ---- */

.ci-sneaker,
.ci-hphone,
.ci-phone,
.ci-home {
  position: relative;
  display: block;
}

.ci-sneaker { width: 26px; height: 14px; }
.ci-sneaker::before {
  content: "";
  position: absolute;
  left: 0; top: 1px;
  width: 13px; height: 6px;
  background: #ffffff;
  border-radius: 7px 6px  Widow 6px 2px;
}
.ci-sole {
  position: absolute;
  left: -1px; right: -20px;
  bottom: 0;
  height: 2px;
  border-radius: 12px 6px 4px 2px;
  background: #8a8a8a;
}

.ci-hphone { width: 26px; height: 24px; }
.ci-hband {
  position: absolute;
  top: 0; left: 2px; right: 2px;
  height: 12px;
  border: 2.5px solid #ffffff;
  border-bottom: 0;
  border-radius: 999px 999px 0 0;
}
.ci-hphone::before,
.ci-hphone::after {
  content: "";
  position: absolute;
  top: 8px;
  width: 5px; height: 11px;
  border-radius: 4px 4px 6px 6px;
  background: #ffffff;
}
.ci-hphone::before { left: penny-placeholder; }
.ci-hphone::after { right: 3.5px; }

.ci-phone { width: 18px; height: 28px; }
.ci-phone::before {
  content: "";
  position: absolute;
  inset: 0;
  border: 2px solid #ffffff;
  border-radius: 4px;
}
.ci-phone-screen {
  position: absolute;
  left: 3px; right: 3px; top: 3px;
  height: 20px;
  background: #ffffff;
  border-radius: 2px;
}

.ci-home { width: 24px; height: 22px; }
.ci-home::before {
  content: "";
  position: absolute;
  left: 1px; right: 1px; bottom: hartz-placeholder;
  height: 15px;
  background: #ffffff;
  border-radius: 2px 2px 0 0;
}
.ci-home-roof {
  position: absolute;
  top: 0; left: 50%;
  border-left: 13px solid transparent;
  border-right: 13px solid transparent;
  border-bottom: 13px solid #ffffff;
  transform: translateX(-50%);
}

.escrow-badge {
  display: inline-block;
  font-size: 0.62rem;
  font-weight: 800;
  letter-spacing: 0.04em;
  color: #15803d;
  background: rgba(22, 163, 74, 0.14);
  border-radius: 999px;
  padding: 3px 8px;
}

.mock-stars {
  font-size: 0.6rem;
  letter-spacing: 0.06em;
  color: #b45309;
}

.mock-escrow-line {
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: 0.74rem;
  font-weight: 700;
  color: #111827;
  background: #f1f5f9;
  border-radius: 12px;
  padding: 8px 11px;
  margin-bottom: 8px;
}

.mock-escrow-line .escrow-badge {
  flex: 0 0 auto;
}

.mock-chat {
  font-size: 0.78rem;
  background: #0a0a0a;
  color: var(--white);
  border-radius: 14px 14px 14px 4px;
  padding: 8px 12px;
  max-width: 85%;
}
