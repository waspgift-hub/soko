# ==========================================================
# SOKO VIBE PRODUCTION SERVER — ENV TEMPLATE v2.0
# Set these in your hosting provider's dashboard.
# NEVER commit real values. This is a template only.
# ==========================================================
NODE_ENV=production
PORT=3000

# ── Firebase Auth (identity) ─────────────────────────────────
# FIREBASE_SERVICE_ACCOUNT_JSON: paste the ENTIRE service-account
# JSON (project settings > service accounts > generate key) as a
# single line. It is read as-is by the server.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project",...}
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# ── PostgreSQL (business data store) ─────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/sokovibe
# Optional read replica (Render: your-DB → Read replicas). Leave blank to read
# from the primary only. Catalog reads route here when set.
DATABASE_URL_REPLICA=

# ── Redis (queues + rate limiting) ───────────────────────────
REDIS_URL=redis://HOST:6379

# ── Cloudflare R2 (media storage) ────────────────────────────
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_IMAGES=soko-vibe-images
R2_BUCKET_VIDEOS=soko-vibe-videos
R2_BUCKET_THUMBNAILS=soko-vibe-thumbnails
R2_BUCKET_BACKUPS=soko-vibe-backups
R2_PUBLIC_URL=https://media.sokovibe.co.tz

# ── ClickPesa (payment gateway) ──────────────────────────────
CLICKPESA_API_URL=https://native.clickpesa.com/api
CLICKPESA_API_KEY=your-clickpesa-api-key
CLICKPESA_API_SECRET=your-clickpesa-api-secret
CLICKPESA_WEBHOOK_SECRET=your-clickpesa-webhook-secret
CLICKPESA_CHECKSUM_KEY=your-clickpesa-checksum-key
CLICKPESA_ALLOWED_IPS=127.0.0.1,::1

# ── SMS ──────────────────────────────────────────────────────
MESEJI_API_KEY=your-meseji-api-key
MESEJI_SENDER_ID=SOKO
NOTIFY_AFRICA_API_KEY=your-notify-africa-key
# Provider base URLs are env-swappable (migration = env change, no code).
MESEJI_BASE_URL=https://meseji.co.tz/api/v1/sms/send
NOTIFY_AFRICA_SMS_BASE_URL=https://api.notify.africa
NOTIFY_AFRICA_SMS_API_KEY=your-notify-africa-sms-key
NOTIFY_AFRICA_SENDER_ID=your-notify-africa-sender-id
# Legacy Cloudinary image cleanup (app media now uses R2).
CLOUDINARY_DESTROY_URL=https://api.cloudinary.com/v1_1/dgbsohnl4/image/destroy

# ── Push Notifications (OneSignal) ───────────────────────────
ONE_SIGNAL_APP_ID=your-onesignal-app-id
ONE_SIGNAL_REST_API_KEY=your-onesignal-rest-key
ONE_SIGNAL_BASE_URL=https://onesignal.com/api/v1

# ── AI (Groq, optional) ──────────────────────────────────────
GROQ_API_KEY=your-groq-api-key

# ── Security ─────────────────────────────────────────────────
# Generate strong random values for all three.
ADMIN_SECRET=generate-a-long-random-string
WEBHOOK_SECRET=generate-a-long-random-string
ENCRYPTION_KEY=generate-a-32-char-random-string

# ── Rate limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Business rules ───────────────────────────────────────────
PLATFORM_COMMISSION_PERCENT=0.035
ESCROW_AUTO_RELEASE_DAYS=14
MAX_DAILY_SALE_AMOUNT=5000000

# ── URLs & CORS ──────────────────────────────────────────────
APP_URL=https://api.sokovibe.co.tz
FRONTEND_URL=https://www.sokovibe.co.tz
ADMIN_URL=https://admin.sokovibe.co.tz
ALLOWED_ORIGINS=https://www.sokovibe.co.tz,https://admin.sokovibe.co.tz
