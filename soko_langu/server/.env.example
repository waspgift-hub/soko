# ==========================================================
# SOKO VIBE PRODUCTION SERVER — ENV TEMPLATE v2.0
# Set these in your hosting provider's dashboard.
# NEVER commit real values. This is a template only.
# ==========================================================
NODE_ENV=production
PORT=3000

# --- Firebase Auth (identity) ---
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project",...}
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# --- Redis (queues + rate limiting) ---
REDIS_URL=redis://HOST:6379

# --- Cloudflare R2 (media storage) ---
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_IMAGES=soko-vibe-images
R2_BUCKET_VIDEOS=soko-vibe-videos
R2_BUCKET_THUMBNAILS=soko-vibe-thumbnails
R2_BUCKET_BACKUPS=soko-vibe-backups
R2_BUCKET_KYC=soko-vibe-kyc
R2_PUBLIC_URL=https://media.sokovibe.co.tz

# --- Cloudflare Email Sending (transactional email / OTP) ---
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cf-api-token-with-email-sending-transact
EMAIL_FROM=no-reply@sokovibe.co.tz
EMAIL_FROM_NAME=Soko Vibe

# --- AzamPay (payment gateway) — replaces ClickPesa ---
# Auth: POST /AppRegistration/GenerateToken {appName, clientId, clientSecret}
AZAMPAY_AUTH_BASE=https://authenticator-sandbox.azampay.co.tz
# Checkout/disbursement base. Sandbox: https://sandbox.azampay.co.tz
# Production base must be confirmed from the AzamPay portal / developer docs.
AZAMPAY_API_BASE=https://sandbox.azampay.co.tz/azampay
AZAMPAY_APP_NAME=your-azampay-app-name
AZAMPAY_CLIENT_ID=your-azampay-client-id
AZAMPAY_CLIENT_SECRET=your-azampay-client-secret
# Callback password AzamPay sends in every callback body; must match this value.
AZAMPAY_CALLBACK_PASSWORD=your-azampay-callback-password
# HMAC-SHA256 over the canonicalised request body (additional integrity check).
AZAMPAY_CHECKSUM_KEY=your-azampay-checksum-key
# Default MNO provider when the caller does not specify one: Airtel | Tigo | Halopesa | Azampesa | Mpesa
AZAMPAY_DEFAULT_PROVIDER=Airtel
AZAMPAY_ALLOWED_IPS=127.0.0.1,::1
# EVERY collection callback is sent to this single URL (server config).
# Must match the webhook registered in the AzamPay portal.
# Production requires it (missing = the server refuses to boot).
AZAMPAY_COLLECTION_WEBHOOK_URL=https://api.sokovibe.co.tz/api/v1/payments/webhook/azampay

# --- SMS ---
MESEJI_API_KEY=your-meseji-api-key
MESEJI_SENDER_ID=SOKO
NOTIFY_AFRICA_API_KEY=your-notify-africa-key
MESEJI_BASE_URL=https://meseji.co.tz/api/v1/sms/send
NOTIFY_AFRICA_SMS_BASE_URL=https://api.notify.africa
NOTIFY_AFRICA_SMS_API_KEY=your-notify-africa-sms-key
NOTIFY_AFRICA_SENDER_ID=your-notify-africa-sender-id

# --- Push Notifications (OneSignal) ---
ONE_SIGNAL_APP_ID=your-onesignal-app-id
ONE_SIGNAL_REST_API_KEY=your-onesignal-rest-key
ONE_SIGNAL_BASE_URL=https://onesignal.com/api/v1

# --- AI (Groq, optional) ---
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key

# Failover order (first configured provider that works wins).
AI_PROVIDER_ORDER=groq,gemini,cloudflare

# Cloudflare Workers AI edge.
CF_AI_URL=https://soko-ai-edge.<subdomain>.workers.dev
CF_AI_KEY=paste-the-workers-AI_EDGE_KEY-here

# Per-provider request ceiling in ms.
AI_PROVIDER_TIMEOUT_MS=10000
AI_BREAKER_COOLDOWN_MS=30000

# Model overrides.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_LITE=gemini-3.5-flash-lite
GEMINI_MODEL_VISION=gemini-3.5-flash-lite
GEMINI_MIN_TOKENS_FOR_THINKING=512

# --- Web search (Tavily) ---
TAVILY_API_KEY=your-tavily-api-key

# --- Security ---
ADMIN_SECRET=generate-a-long-random-string
WEBHOOK_SECRET=generate-a-long-random-string
ENCRYPTION_KEY=generate-a-32-char-random-string
# Comma-separated bootstrap super-admin emails (granted role super_admin/isAdmin on auth).
SUPER_ADMIN_EMAILS=admin@sokovibe.co.tz

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- Business rules ---
PLATFORM_COMMISSION_PERCENT=0.035
ESCROW_AUTO_RELEASE_DAYS=14
MAX_DAILY_SALE_AMOUNT=5000000

# --- URLs & CORS ---
APP_URL=https://api.sokovibe.co.tz
FRONTEND_URL=https://www.sokovibe.co.tz
ADMIN_URL=https://admin.sokovibe.co.tz
ALLOWED_ORIGINS=https://www.sokovibe.co.tz,https://admin.sokovibe.co.tz

# --- Cloudflare Turnstile (bot protection for public forms) ---
TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET=your-turnstile-secret
TURNSTILE_HOSTNAMES=www.sokovibe.co.tz,sokovibe.co.tz,localhost,127.0.0.1

# --- WhatsApp Business Cloud API ---
WHATSAPP_BUSINESS_TOKEN=your-whatsapp-cloud-api-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_TEMPLATE_NAME=otp
WHATSAPP_LANGUAGE=sw
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-long-random-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret

# --- ElevenLabs text-to-speech (server-side only) ---
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.75
ELEVENLABS_STYLE=0
