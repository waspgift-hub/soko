# ==========================================================
# SOKO VIBE PRODUCTION SERVER — ENV TEMPLATE v2.0
# Set these in your hosting provider's dashboard.
# NEVER commit real values. This is a template only.
# ==========================================================
NODE_ENV=production
PORT=3000

# ── Firebase Auth (identity) ─────────────────────────────────
# FIREBASE_SERVICE_ACCOUNT_JSON: paste the ENTIRE service-account
# JSON (project settings > service accounts > generate key) as a
# single line. It is read as-is by the server.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project",...}
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# ── Redis (queues + rate limiting) ───────────────────────────
REDIS_URL=redis://HOST:6379

# ── Cloudflare R2 (media storage) ────────────────────────────
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_IMAGES=soko-vibe-images
R2_BUCKET_VIDEOS=soko-vibe-videos
R2_BUCKET_THUMBNAILS=soko-vibe-thumbnails
R2_BUCKET_BACKUPS=soko-vibe-backups
R2_PUBLIC_URL=https://media.sokovibe.co.tz

# ── Cloudflare Email Sending (transactional email / OTP) ────
# All transactional email (OTP, KYC, admin broadcast) is sent from the brand
# domain via Cloudflare Email Sending. Onboard sokovibe.co.tz first
# (Compute & AI > Email Service > Email Sending) — Cloudflare auto-adds the
# SPF + DKIM DNS records. API token needs the "Email Sending:Transact:Send"
# permission (and Read to verify). Free tier: 3,000 emails/month.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cf-api-token-with-email-sending-transact
EMAIL_FROM=no-reply@sokovibe.co.tz
EMAIL_FROM_NAME=Soko Vibe
# Fallback SMTP is used ONLY when the Cloudflare creds above are absent
# (local dev). For a personal Gmail, SMTP_PASS must be an App Password,
# not the normal password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# ── ClickPesa (payment gateway) ──────────────────────────────
CLICKPESA_API_URL=https://native.clickpesa.com/api
CLICKPESA_API_KEY=your-clickpesa-api-key
CLICKPESA_API_SECRET=your-clickpesa-api-secret
CLICKPESA_WEBHOOK_SECRET=your-clickpesa-webhook-secret
CLICKPESA_CHECKSUM_KEY=your-clickpesa-checksum-key
CLICKPESA_ALLOWED_IPS=127.0.0.1,::1
# EVERY collection callback is sent to this single URL (server config).
# Must match the webhook you registered in the ClickPesa dashboard.
# Production requires it (missing = the server refuses to boot).
CLICKPESA_COLLECTION_WEBHOOK_URL=https://soko-langu-server.onrender.com/api/v1/payments/webhook/clickpesa

# ── SMS ──────────────────────────────────────────────────────
MESEJI_API_KEY=your-meseji-api-key
MESEJI_SENDER_ID=SOKO
NOTIFY_AFRICA_API_KEY=your-notify-africa-key
# Provider base URLs are env-swappable (migration = env change, no code).
MESEJI_BASE_URL=https://meseji.co.tz/api/v1/sms/send
NOTIFY_AFRICA_SMS_BASE_URL=https://api.notify.africa
NOTIFY_AFRICA_SMS_API_KEY=your-notify-africa-sms-key
NOTIFY_AFRICA_SENDER_ID=your-notify-africa-sender-id
# Legacy Cloudinary image cleanup (app media now uses R2).
CLOUDINARY_DESTROY_URL=https://api.cloudinary.com/v1_1/dgbsohnl4/image/destroy

# ── Push Notifications (OneSignal) ───────────────────────────
ONE_SIGNAL_APP_ID=your-onesignal-app-id
ONE_SIGNAL_REST_API_KEY=your-onesignal-rest-key
ONE_SIGNAL_BASE_URL=https://onesignal.com/api/v1

# ── AI (Groq, optional) ──────────────────────────────────────
GROQ_API_KEY=your-groq-api-key

# Gemini is the FALLBACK provider: the server fails over to it when Groq returns
# 429 / 5xx / times out. Without this key the app still works, it just has no
# fallback. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Failover order (first configured provider that works wins).
AI_PROVIDER_ORDER=groq,gemini

# Per-provider request ceiling in ms. Two sequential providers must fit inside
# the app's 25s client timeout, so keep 2x this value under 25s.
AI_PROVIDER_TIMEOUT_MS=10000

# How long a provider's circuit stays open before a single probe is allowed
# through. Groq 429s carry a `retry-after` that often exceeds 30s, so raise this
# above your plan's rate-limit window or the probe just burns another request.
AI_BREAKER_COOLDOWN_MS=30000

# Model overrides. The Flutter client sends Groq model ids; the server maps them
# to these.
#
# Defaults are gemini-3.5-flash-lite, NOT gemini-3.8-flash, on purpose: measured
# on a free-tier key, 3.8-flash served 1/8 text calls and 0/8 vision calls, while
# Flash-Lite served 8/8 and 8/8 at a third of the latency. Only raise this to a
# thinking model if the Google project is on a paid tier.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_LITE=gemini-3.5-flash-lite
GEMINI_MODEL_VISION=gemini-3.5-flash-lite

# Token budgets below this are routed to GEMINI_MODEL_LITE, because a thinking
# model can spend the whole budget on internal reasoning and return a reply
# truncated mid-word. The app sends 80 (image id) and 200 (search summary).
GEMINI_MIN_TOKENS_FOR_THINKING=512

# ── Web search (Tavily) ───────────────────────────────────────
# Backs the search_web tool, which is the only way the assistant can answer
# anything outside Soko Vibe (exchange rates, laws, news, prices elsewhere).
# Without it the tool returns no sources and the model is forced to say it
# cannot confirm rather than answering from memory.
#
# Required in production too: set it in the Render dashboard, not just locally.
TAVILY_API_KEY=your-tavily-api-key

# ── Security ─────────────────────────────────────────────────
# Generate strong random values for all three.
ADMIN_SECRET=generate-a-long-random-string
WEBHOOK_SECRET=generate-a-long-random-string
ENCRYPTION_KEY=generate-a-32-char-random-string

# ── Rate limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Business rules ───────────────────────────────────────────
PLATFORM_COMMISSION_PERCENT=0.035
ESCROW_AUTO_RELEASE_DAYS=14
MAX_DAILY_SALE_AMOUNT=5000000

# ── URLs & CORS ──────────────────────────────────────────────
# Canonical public API URL (Flutter base URL host). Required in production.
APP_URL=https://api.sokovibe.co.tz
FRONTEND_URL=https://www.sokovibe.co.tz
ADMIN_URL=https://admin.sokovibe.co.tz
ALLOWED_ORIGINS=https://www.sokovibe.co.tz,https://admin.sokovibe.co.tz
