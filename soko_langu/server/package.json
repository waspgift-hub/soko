{
  "name": "soko-langu-server",
  "version": "2.0.0",
  "description": "Soko Vibe backend server - Production Trust-Commerce Platform",
  "main": "src/index.js",
  "scripts": {
    "start": "node --optimize-for-size --expose-gc src/index.js",
    "dev": "node src/index.js",
    "worker": "node src/workers/index.js",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "generate": "prisma generate",
    "postinstall": "prisma generate",
    "test": "node --test test/*.test.js",
    "test:e2e": "node --test test/e2e.live.test.js",
    "lint": "eslint src/"
  },
  "engines": {
    "node": ">=18"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1125.0",
    "@aws-sdk/s3-request-presigner": "^3.1125.0",
    "@prisma/client": "^5.22.0",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.12.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "firebase-admin": "^11.11.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "ip-range-check": "^0.2.1",
    "nodemailer": "^6.9.8",
    "prisma": "^5.22.0",
    "zod": "^3.23.8"
  }
}
