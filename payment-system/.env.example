DATABASE_URL="postgresql://user:password@host:5432/payment_db?schema=public"

# Redis URL provided by Render Redis service or Upstash
REDIS_URL="redis://default:password@host:6379"

# API server port (Render assigns dynamically, fallback to 10000)
PORT=10000

# Webhook secret to verify signature from payment gateway
WEBHOOK_SECRET="your-webhook-secret-here"

# Node environment
NODE_ENV=production

# Logging level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info
