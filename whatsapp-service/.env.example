# Meta WhatsApp Cloud API
# Never commit the real .env file. Copy this file to .env and fill it in.
USER_ACCESS_TOKEN=
PHONE_NUMBER_ID=1348363461701375
VERSION=v25.0

PORT=3000

# Protects this API. Every request must send the header: x-api-key: <API_KEY>
# Leave empty only on a private network during local testing.
API_KEY=

# Requests allowed per minute per IP across all /api routes
RATE_LIMIT_PER_MINUTE=60

# Bulk limits
BULK_MAX_RECIPIENTS=500
BULK_CONCURRENCY=5

# Country code used when a number starts with 0 (Tanzania = 255)
DEFAULT_COUNTRY_CODE=255

# Append-only JSON-lines log of every message attempt
LOG_FILE=logs/messages.log
